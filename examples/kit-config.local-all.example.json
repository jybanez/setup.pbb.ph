        "database": "pbb_realtime",
        "username": "root",
        "password": ""
      },
      "config": {
        "realtime": {
          "service_name": "PBB Realtime Local",
          "token_audience": "pbb-realtime",
          "token_signing_secret": "REPLACE_WITH_REALTIME_TOKEN_SECRET",
          "trusted_issuers": ["localhost"],
          "public_websocket_url": "ws://127.0.0.1:8080/realtime",
          "ws_bind_address": "127.0.0.1",
          "ws_port": 8080,
          "allowed_origins": ["http://localhost"],
          "populate": {
            "enabled": false,
            "options": {
              "overwrite_secrets": false,
              "dry_run": true
            },
            "clients": []
          }
        }
      }
    },
    {
      "id": "pbb-relay",
      "enabled": true,
      "release_path": "C:\\wamp64\\www\\pbb\\relay",
      "mode": "repair",
      "install_path": "C:\\wamp64\\www\\pbb\\relay",
      "public_path": "C:\\wamp64\\www\\pbb\\relay\\public",
      "app_url": "http://localhost/pbb/relay/public",
      "depends_on": ["pbb-maestro"],
      "database": {
        "driver": "mysql",
        "host": "127.0.0.1",
        "port": 3306,
        "database": "pbb_relay",
        "username": "root",
        "password": ""
      },
      "config": {
        "relay": {
          "hub_id": "local-dev-node",
          "hq_api_base_url": "https://hub.pbb.ph",
          "targets": [],
          "maestro_enabled": true
        }
      }
    },
    {
      "id": "pbb-hotline",
      "enabled": true,
      "release_path": "C:\\wamp64\\www\\pbb\\hotline",
      "mode": "repair",
      "install_path": "C:\\wamp64\\www\\pbb\\hotline",
      "public_path": "C:\\wamp64\\www\\pbb\\hotline\\public",
      "app_url": "http://localhost/pbb/hotline/public",
