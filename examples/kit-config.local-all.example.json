        "database": "pbb_hotline",
        "username": "root",
        "password": ""
      },
      "config": {
        "hotline": {
          "citizen_session_lifetime": 43200,
          "media_assembly_token": "REPLACE_WITH_HOTLINE_MEDIA_ASSEMBLY_TOKEN",
